# ─── Environment / Secrets ──────────────────────────────────────────────────
# NEVER commit actual .env files — commit .env.example instead
.env
.env.*
!.env.example       # allow the template
*.local

# ─── Python ─────────────────────────────────────────────────────────────────
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
**/*.pyc
**/*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Node / Frontend ─────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── Data & ML ───────────────────────────────────────────────────────────────
data/*.csv
data/*.db
data/*.sqlite
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5
ml/models/*.pt
ml/models/*.pth

# ─── IDE & OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
